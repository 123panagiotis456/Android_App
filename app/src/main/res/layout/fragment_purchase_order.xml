<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/market_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/market_surface"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/purchase_order_title"
        app:titleTextAppearance="@style/TextAppearance.Market.ItemTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/orderSummary"
        style="@style/Widget.Market.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/orderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Market.Secondary"
                tools:text="5 Ιουλ 2025, 22:14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:labelFor="@id/orderTotal"
                    android:text="@string/purchase_order_total_label"
                    android:textAppearance="@style/TextAppearance.Market.ItemTitle" />

                <TextView
                    android:id="@+id/orderTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Market.Price"
                    tools:text="3,90 €" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/orderProductsHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:text="@string/purchase_order_products"
        android:textAppearance="@style/TextAppearance.Market.ItemTitle"
        android:visibility="gone"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/orderProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            tools:listitem="@layout/item_purchase_order_product" />

        <ProgressBar
            android:id="@+id/orderProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/orderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="24dp"
            android:textAppearance="@style/TextAppearance.Market.Secondary"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/cartFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/market_surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cartUnitCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Market.Secondary"
                tools:text="2 μονάδες στο καλάθι" />

            <TextView
                android:id="@+id/cartCurrentTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Market.ItemTitle"
                tools:text="4,80 €" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openCart"
            style="@style/Widget.Market.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/purchase_order_view_cart"
            app:icon="@drawable/shopping_basket"
            app:iconGravity="textStart"
            app:iconTint="@color/market_primary_text" />
    </LinearLayout>
</LinearLayout>
