<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Market.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPurchaseDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Market.ItemTitle"
            tools:text="5 Ιουλ 2025, 22:14" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/market_outline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:labelFor="@id/tvTotalCost"
                android:text="@string/cart_total_label"
                android:textAppearance="@style/TextAppearance.Market.ItemTitle" />

            <TextView
                android:id="@+id/tvTotalCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Market.Price"
                tools:text="3,90 €" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderDetailsAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/purchase_history_show_products"
            android:textColor="@color/market_mint"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductsDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.Market.Secondary"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="2 × Γάλα · 1,20 € / μονάδα&#10;1 × Ψωμί · 1,50 € / μονάδα" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReaddToCart"
            style="@style/Widget.Market.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/purchase_history_readd"
            android:visibility="gone"
            tools:visibility="visible"
            app:icon="@drawable/shopping_basket"
            app:iconGravity="textStart"
            app:iconTint="@color/market_primary_text" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
