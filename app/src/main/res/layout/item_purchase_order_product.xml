<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Market.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/productImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/market_product_image"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/milk_carton_svgrepo_com" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/productName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Market.ItemTitle"
                tools:text="Γάλα 1L" />

            <TextView
                android:id="@+id/productPurchase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Market.Secondary"
                tools:text="Ποσότητα αγοράς: 2" />

            <TextView
                android:id="@+id/productPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Market.Secondary"
                android:textColor="@color/market_mint"
                android:textStyle="bold"
                tools:text="1,20 € / μονάδα" />

            <TextView
                android:id="@+id/productPaidTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Market.Secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/productCartQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Market.Secondary"
                android:textColor="@color/market_mint"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Στο καλάθι: 2"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/productUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/purchase_order_unavailable"
                android:textAppearance="@style/TextAppearance.Market.Secondary"
                android:textColor="@color/market_offer_text"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/addProduct"
            style="@style/Widget.Market.QuantityButton"
            app:srcCompat="@drawable/ic_add"
            tools:contentDescription="@string/add_product" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
