<resources>

    <style name="Theme.SupermarketManager" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/market_mint</item>
        <item name="colorPrimaryVariant">@color/market_raised</item>
        <item name="colorOnPrimary">@color/market_on_mint</item>
        <item name="colorSecondary">@color/market_mint</item>
        <item name="colorOnSecondary">@color/market_on_mint</item>
        <item name="colorSurface">@color/market_surface</item>
        <item name="colorOnSurface">@color/market_text</item>
        <item name="colorOnBackground">@color/market_text</item>
        <item name="android:colorBackground">@color/market_background</item>
        <item name="android:windowBackground">@color/market_background</item>
        <item name="android:statusBarColor">@color/market_background</item>
        <item name="android:navigationBarColor">@color/market_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SupermarketManager.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/market_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SupermarketManager</item>
    </style>

    <style name="ThemeOverlay.SupermarketManager.FilterSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Market.FilterSheet</item>
    </style>

    <style name="Widget.Market.FilterSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/market_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Market.FilterSheet</item>
    </style>

    <style name="ShapeAppearanceOverlay.Market.FilterSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
