<resources>
    <style name="TextAppearance.Market.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/market_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Market.ItemTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/market_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Market.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/market_muted</item>
    </style>

    <style name="TextAppearance.Market.Price" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/market_mint</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Market.QuantityButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/market_quantity_button</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">@color/market_control_tint</item>
    </style>

    <style name="Widget.Market.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/market_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/market_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Market.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/market_primary_text</item>
        <item name="backgroundTint">@color/market_primary_background</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
